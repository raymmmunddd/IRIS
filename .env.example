DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Keep this low for hosted/serverless deployments; increase only when the database
# connection limit and hosting concurrency can support it.
DATABASE_POOL_MAX=3
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
DATABASE_POOL_MAX_LIFETIME_SECONDS=300

RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MAIL_FROM="IRIS <onboarding@example.com>"

# Optional: enables Gemini Flash-backed report categorization. Without this, IRIS uses local rules.
GEMINI_API_KEY="AIza..."
GEMINI_MODEL="gemini-2.5-flash"
