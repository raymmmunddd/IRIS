generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  RESIDENT
  ADMIN
  BPAT_OFFICER
  LUPON
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OfficerRoleTitle {
  BPAT_OFFICER
  LUPON_MEMBER
  LUPON_CHAIR
  BARANGAY_CAPTAIN
  BARANGAY_SECRETARY
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CaseReviewStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  REFERRED
  ASSIGNED
  SCHEDULED
  ONGOING
  RESOLVED
  UNRESOLVED
  DISMISSED
  ARCHIVED
}

enum HearingStage {
  MEDIATION
  CONCILIATION
}

enum HearingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  POSTPONED
}

enum HearingOutcome {
  RESOLVED
  UNRESOLVED
  ADJOURNED
  DISMISSED
}

enum NotificationType {
  CASE_UPDATE
  HEARING_SCHEDULED
  SETTLEMENT
  ANNOUNCEMENT
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  ASSIGN
  ARCHIVE
  LOGIN
}

enum CaseStatus {
  SCHEDULED
  MEDIATION
  CONCILIATION
  ARBITRATION
  RESOLVED
  REPUDIATION
  DISMISSED
  WITHDRAWN
}

enum SettlementSource {
  MEDIATION
  CONCILIATION
  ARBITRATION
}

enum RepudiatedBy {
  COMPLAINANT
  RESPONDENT
}

enum ExecutionMethod {
  LUPON
  COURT
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                  String     @id @default(uuid())
  fullName            String     @map("full_name")
  email               String     @unique
  password            String?
  contact             String?
  street              String?
  locationLatitude    Float?     @map("location_latitude")
  locationLongitude   Float?     @map("location_longitude")
  locationAccuracy    Float?     @map("location_accuracy")
  locationAddress     String?    @map("location_address")
  locationCapturedAt  DateTime?  @map("location_captured_at") @db.Timestamp(6)
  bio                 String?
  photoUrl            String?    @map("photo_url")
  gender              Gender?
  genderDetails       String?    @map("gender_details")
  passwordLastUpdated DateTime?  @map("password_last_updated")
  twoFactorEnabled    Boolean    @default(false) @map("two_factor_enabled")
  role                UserRole   @default(RESIDENT)
  status              UserStatus @default(ACTIVE)
  isArchived          Boolean    @default(false) @map("is_archived")
  archivedAt          DateTime?  @map("archived_at")
  archivedReason      String?    @map("archived_reason")
  suspensionReason    String?    @map("suspension_reason")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  officer            Officer?
  identity           ResidentIdentity?
  casesAsComplainant Case[]              @relation("Complainant")
  casesAsRespondent  Case[]              @relation("Respondent")
  notifications      Notification[]
  announcements      Announcement[]
  caseStatusHistory  CaseStatusHistory[]
  activities         UserActivity[]

  @@index([isArchived, createdAt])
  @@index([role, isArchived])
  @@map("users")
}

model ResidentIdentity {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  dateOfBirth          DateTime @map("date_of_birth") @db.Date
  governmentIdImage    Bytes    @map("government_id_image")
  governmentIdMimeType String   @map("government_id_mime_type")
  createdAt            DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resident_identities")
}

model PasswordResetCode {
  email      String    @id
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamp(6)
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamp(6)

  @@index([expiresAt])
  @@map("password_reset_codes")
}

model Officer {
  id        String           @id @default(uuid())
  userId    String           @unique @map("user_id")
  fullName  String           @map("full_name")
  roleTitle OfficerRoleTitle @map("role_title")
  createdAt DateTime         @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cases    Case[]
  hearings Hearing[]

  @@index([fullName])
  @@map("officers")
}

model Case {
  id                           String            @id @default(uuid())
  caseNumber                   String            @unique @map("case_number")
  complainantId                String            @map("complainant_id")
  respondentId                 String?           @map("respondent_id")
  respondentName               String?           @map("respondent_name")
  respondentAddress            String?           @map("respondent_address")
  incidentStreet               String?           @map("incident_street")
  incidentLatitude             Decimal?          @map("incident_latitude") @db.Decimal(9, 6)
  incidentLongitude            Decimal?          @map("incident_longitude") @db.Decimal(10, 6)
  incidentAccuracy             Float?            @map("incident_accuracy")
  incidentLocation             String?           @map("incident_location")
  assignedOfficerId            String?           @map("assigned_officer_id")
  category                     String
  type                         String
  details                      String            @db.Text
  priority                     CasePriority      @default(MEDIUM)
  status                       CaseReviewStatus  @default(PENDING)
  currentStatus                CaseStatus        @default(SCHEDULED) @map("current_status")
  previousStatus               CaseStatus?       @map("previous_status")
  filingDate                   DateTime          @default(now()) @map("filing_date") @db.Date
  statusEnteredDate            DateTime          @default(now()) @map("status_entered_date") @db.Date
  statusDaysAllotted           Int?              @map("status_days_allotted")
  mediationAttemptCount        Int               @default(0) @map("mediation_attempt_count")
  conciliationAttemptCount     Int               @default(0) @map("conciliation_attempt_count")
  absenceCount                 Int               @default(0) @map("absence_count")
  arbitrationAgreementSigned   Boolean           @default(false) @map("arbitration_agreement_signed")
  arbitrationAgreementDate     DateTime?         @map("arbitration_agreement_date") @db.Date
  arbitrationAwardDate         DateTime?         @map("arbitration_award_date") @db.Date
  settlementDate               DateTime?         @map("settlement_date") @db.Date
  settlementSource             SettlementSource? @map("settlement_source")
  repudiationDate              DateTime?         @map("repudiation_date") @db.Date
  repudiationDeadline          DateTime?         @map("repudiation_deadline") @db.Date
  repudiationReason            String?           @map("repudiation_reason") @db.Text
  repudiatedBy                 RepudiatedBy?     @map("repudiated_by")
  closedDate                   DateTime?         @map("closed_date") @db.Date
  executionDeadline            DateTime?         @map("execution_deadline") @db.Date
  executionMethod              ExecutionMethod?  @map("execution_method")
  needsCertificateToFileAction Boolean           @default(false) @map("needs_certificate_to_file_action")
  withdrawalReason             String?           @map("withdrawal_reason") @db.Text
  deadlineDate                 DateTime?         @map("deadline_date")
  dismissedReason              String?           @map("dismissed_reason")
  isArchived                   Boolean           @default(false) @map("is_archived")
  archivedAt                   DateTime?         @map("archived_at")
  dateSubmitted                DateTime          @default(now()) @map("date_submitted")
  incidentDate                 DateTime          @map("incident_date") @db.Date
  updatedAt                    DateTime          @updatedAt @map("updated_at")

  complainant     User                 @relation("Complainant", fields: [complainantId], references: [id])
  respondent      User?                @relation("Respondent", fields: [respondentId], references: [id])
  assignedOfficer Officer?             @relation(fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  evidence        Evidence[]
  hearings        Hearing[]
  statusHistory   CaseStatusHistory[]
  processHistory  CaseProcessHistory[]
  settlement      Settlement?
  auditLogs       AuditLog[]
  chatMessages    CaseChatMessage[]

  @@index([status, dateSubmitted])
  @@index([status, priority, dateSubmitted])
  @@index([assignedOfficerId, status])
  @@index([dateSubmitted])
  @@index([category])
  @@index([complainantId, dateSubmitted])
  @@index([currentStatus, statusEnteredDate])
  @@index([isArchived, filingDate])
  @@map("cases")
}

model CaseMonthlySequence {
  year      Int
  month     Int
  lastNumber Int @map("last_number")

  @@id([year, month])
  @@map("case_monthly_sequences")
}

model CaseProcessHistory {
  id                String     @id @default(uuid())
  caseId            String     @map("case_id")
  event             String
  fromStatus        CaseStatus @map("from_status")
  toStatus          CaseStatus @map("to_status")
  changedAt         DateTime   @default(now()) @map("changed_at") @db.Timestamp(6)
  businessDaysSpent Int        @default(0) @map("business_days_spent")
  details           String?    @db.Text

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, changedAt])
  @@map("case_process_history")
}

model Hearing {
  id                  String          @id @default(uuid())
  caseId              String          @map("case_id")
  conductedBy         String?         @map("conducted_by")
  hearingNumber       Int             @map("hearing_number")
  stage               HearingStage
  scheduledDate       DateTime        @map("scheduled_date")
  scheduledTime       String          @map("scheduled_time")
  location            String
  notes               String?
  complainantAttended Boolean         @default(false) @map("complainant_attended")
  respondentAttended  Boolean         @default(false) @map("respondent_attended")
  outcome             HearingOutcome?
  status              HearingStatus   @default(SCHEDULED)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  case    Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  officer Officer? @relation(fields: [conductedBy], references: [id], onDelete: SetNull)

  @@index([caseId, scheduledDate])
  @@index([conductedBy, scheduledDate])
  @@map("hearings")
}

model Evidence {
  id         String   @id @default(uuid())
  caseId     String   @map("case_id")
  fileUrl    String   @map("file_url")
  fileType   String   @map("file_type")
  fileName   String?  @map("file_name")
  fileData   Bytes?   @map("file_data")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, uploadedAt])
  @@map("evidence")
}

model Settlement {
  id                String    @id @default(uuid())
  caseId            String    @unique @map("case_id")
  agreementText     String    @map("agreement_text")
  proofUrl          String?   @map("proof_url")
  complainantSigned Boolean   @default(false) @map("complainant_signed")
  respondentSigned  Boolean   @default(false) @map("respondent_signed")
  signedAt          DateTime? @map("signed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("settlements")
}

model CaseStatusHistory {
  id        String           @id @default(uuid())
  caseId    String           @map("case_id")
  changedBy String           @map("changed_by")
  oldStatus CaseReviewStatus @map("old_status")
  newStatus CaseReviewStatus @map("new_status")
  changedAt DateTime         @default(now()) @map("changed_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [changedBy], references: [id])

  @@map("case_status_history")
}

model Announcement {
  id          String   @id @default(uuid())
  createdBy   String   @map("created_by")
  title       String
  content     String
  imageUrl    String?  @map("image_url")
  publishedAt DateTime @default(now()) @map("published_at")

  author User @relation(fields: [createdBy], references: [id])

  @@map("announcements")
}

model AuditLog {
  id          String      @id @default(uuid())
  actorId     String      @map("actor_id")
  action      AuditAction
  targetTable String      @map("target_table")
  targetId    String      @map("target_id")
  caseId      String?     @map("case_id")
  changes     Json
  loggedAt    DateTime    @default(now()) @map("logged_at")

  case Case? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([loggedAt])
  @@index([targetTable, targetId, loggedAt])
  @@index([caseId, loggedAt])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  message   String
  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model CaseChatMessage {
  id         String   @id @default(uuid())
  caseId     String   @map("case_id")
  senderId   String   @map("sender_id")
  senderRole String   @map("sender_role")
  message    String
  createdAt  DateTime @default(now()) @map("created_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("case_chat_messages")
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  label     String
  detail    String
  category  String
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_activities")
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
